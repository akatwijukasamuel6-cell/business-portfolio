# Admin login credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email (SMTP) settings - required for the contact form to send emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact form messages are delivered (leave blank to use the Contact page email)
MAIL_TO=your-email@gmail.com

# From address on outgoing emails (optional)
MAIL_FROM=your-email@gmail.com
